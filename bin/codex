#!/usr/bin/env bash
# Generated By: Claude Code (claude-opus-5-5[1m])
#
# PATH shim for Codex: pin a launch-directory project identity, then exec the
# native CLI. First on PATH on the host (~/source/claude-otel-stack/bin) and in
# the sandbox image (/sandbox/bin).

set -euo pipefail

# The hook payload's cwd follows the current Codex directory. Capture a
# project identity separately so hooks have one that survives /cd.
#
# An inherited project wins over the launch directory: a sandbox carries it in
# OTEL_RESOURCE_ATTRIBUTES from /sandbox/.env (its $PWD is /sandbox/source/ in
# every sandbox), and a nested codex inherits its parent's. CODEX_PROJECT
# follows it so the two cannot disagree. Anchored on the key so e.g.
# sandbox.project= does not count.
project_attr=',project=([^,]*),'
if [[ ",${OTEL_RESOURCE_ATTRIBUTES:-}," =~ $project_attr ]]; then
    export CODEX_PROJECT="${CODEX_PROJECT:-${BASH_REMATCH[1]}}"
else
    export CODEX_PROJECT="${CODEX_PROJECT:-$PWD}"
    export OTEL_RESOURCE_ATTRIBUTES="${OTEL_RESOURCE_ATTRIBUTES:+${OTEL_RESOURCE_ATTRIBUTES},}project=${CODEX_PROJECT}"
fi

# The native CLI by path, not by PATH lookup, so this shim can never reach
# itself or another copy of itself. /usr/bin is where the sandbox image puts
# it; a host with it elsewhere exports CODEX_CMD. A bare name would be looked up
# on PATH and land back here, so only an absolute path is accepted.
# ponytail: an absolute path pointing at a shim copy still loops; not guarded.
CODEX_CMD="${CODEX_CMD:-/usr/bin/codex}"
[[ "$CODEX_CMD" == /* ]] || { echo "codex: CODEX_CMD must be an absolute path, got '$CODEX_CMD'" >&2; exit 127; }
exec "$CODEX_CMD" "$@"
