#!/usr/bin/env bash
# Generated By: Claude Code (claude-opus-5-5[1m])
#
# PATH shim for Codex: pin a launch-directory project identity, then exec the
# native CLI. First on PATH on the host (~/source/claude-otel-stack/bin).

set -euo pipefail

# Host invocations use their launch directory. Any inherited `project` is
# replaced, so a parent codex or a stale export cannot pin a child elsewhere.
export CODEX_PROJECT="$PWD"
IFS=, read -ra attrs <<< "${OTEL_RESOURCE_ATTRIBUTES:-}"
host_attrs=
for attr in "${attrs[@]}"; do
    if [[ -n "$attr" && "$attr" != project=* ]]; then
        host_attrs="${host_attrs:+${host_attrs},}${attr}"
    fi
done
export OTEL_RESOURCE_ATTRIBUTES="${host_attrs:+${host_attrs},}project=${CODEX_PROJECT}"

# Codex's managed app-server daemon shares the environment captured at daemon
# startup across separate clients, so a per-client project identity does not
# reach tool commands or native telemetry. --no-daemon bypasses an
# already-running daemon.
#
# The native CLI by path, not by PATH lookup, so this shim can never reach
# itself or another copy of itself. /usr/bin is where the npm install puts it;
# a host with it elsewhere exports CODEX_CMD. A bare name would be looked up on
# PATH and land back here, so only an absolute path is accepted. A drive letter
# counts: native Windows make hands /c/... to recipes as C:/...
# ponytail: an absolute path pointing at a shim copy still loops; not guarded.
CODEX_CMD="${CODEX_CMD:-/usr/local/bin/codex}"
[[ "$CODEX_CMD" == /* || "$CODEX_CMD" == [A-Za-z]:[/\\]* ]] || { echo "codex: CODEX_CMD must be an absolute path, got '$CODEX_CMD'" >&2; exit 127; }
exec "$CODEX_CMD" "--no-daemon" "$@"
