#!/bin/bash
# Generated By: Claude Code (claude-opus-5-5[1m])
#
# PATH shim for Claude Code: telemetry env and headless tagging, then exec the
# native CLI. First on PATH on the host (~/source/claude-otel-stack/bin) and in
# the sandbox image (/sandbox/bin), so every `claude` resolved by name —
# shells, scripts, a nested `claude -p` — passes through here.

add_attr() {  # add_attr <key> <value>: append to OTEL_RESOURCE_ATTRIBUTES unless key is set
    [[ ",${OTEL_RESOURCE_ATTRIBUTES:-}," == *",$1="* ]] ||
        export OTEL_RESOURCE_ATTRIBUTES="${OTEL_RESOURCE_ATTRIBUTES:+${OTEL_RESOURCE_ATTRIBUTES},}$1=$2"
}

# Host only. In an openshell-sandbox, telemetry is inherited from its bashrc
# and /sandbox/.env (endpoint through the proxy, http/protobuf, the sandbox's
# own project and identity), which these host values would overwrite.
#
# Set here on every launch, not in the host bashrc: Claude Code strips OTEL_*
# from the env of its tool subprocesses, so a nested `claude -p` only has
# telemetry because this shim puts it back.
if [[ ! -f /sandbox/.env ]]; then
    export CLAUDE_CODE_ENABLE_TELEMETRY=1
    export CLAUDE_CODE_ENHANCED_TELEMETRY_BETA=1

    # Metrics → OTLP → Collector → Prometheus
    export OTEL_METRICS_EXPORTER=otlp
    export OTEL_METRIC_EXPORT_INTERVAL=10000

    # Events/Logs → OTLP → Collector → Loki
    export OTEL_LOGS_EXPORTER=otlp
    export OTEL_LOGS_EXPORT_INTERVAL=2000

    # Traces → OTLP → Collector → Tempo. Shorter batch delay so completed child
    # spans surface faster in dashboards.
    export OTEL_TRACES_EXPORTER=otlp
    export OTEL_BSP_SCHEDULE_DELAY=2000
    export OTEL_BSP_MAX_EXPORT_BATCH_SIZE=128

    # OTLP endpoint (collector on localhost)
    export OTEL_EXPORTER_OTLP_PROTOCOL=grpc
    export OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

    # Include tool details and user prompts (POC only — review before sharing)
    export OTEL_LOG_TOOL_DETAILS=1
    export OTEL_LOG_USER_PROMPTS=1

    # Added only when absent, so attributes a caller set win: the review
    # orchestrator's children keep the parent's project, and its review.* keys
    # survive. A launch with nothing inherited gets its own directory.
    add_attr user.name "${USER:-}"
    add_attr environment dev
    add_attr project "$PWD"
    add_attr host.name "$(hostname)"
fi

# Headless (-p/--print) runs get a resource attribute so telemetry consumers
# (claude-dashboard remote rows) can filter them out. Claude Code emits no
# native headless marker (verified through 2.1.233).
for arg in "$@"; do
    if [[ "$arg" == -p || "$arg" == --print ]]; then
        add_attr headless true
        break
    fi
done

# The native CLI by path, not by PATH lookup, so this shim can never reach
# itself or another copy of itself. /usr/bin is where the sandbox image puts
# it; a host with it elsewhere exports CLAUDE_CMD. A bare name would be looked up
# on PATH and land back here, so only an absolute path is accepted.
# ponytail: an absolute path pointing at a shim copy still loops; not guarded.
CLAUDE_CMD="${CLAUDE_CMD:-/usr/bin/claude}"
[[ "$CLAUDE_CMD" == /* ]] || { echo "claude: CLAUDE_CMD must be an absolute path, got '$CLAUDE_CMD'" >&2; exit 127; }
exec "$CLAUDE_CMD" "$@"
