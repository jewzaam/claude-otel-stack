{
  "uid": "host-process-explorer",
  "title": "Process Group Explorer",
  "schemaVersion": 42,
  "description": "Filter process-exporter group names with a PromQL regular expression. The table includes every matching group; the charts show the top 10 matching groups. Group names reflect exported labels (for example, the live Falcon group is named falcon-sensor-b).",
  "tags": [
    "host",
    "process-exporter"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "liveNow": false,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "groupname_regex",
        "type": "textbox",
        "label": "Groupname regex",
        "hide": 0,
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        },
        "skipUrlSync": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Matching groups: CPU",
      "description": "CPU y-axis fixed to 14 logical CPUs.",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "pluginVersion": "13.0.1",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "drawStyle": "line",
            "fillOpacity": 12,
            "gradientMode": "none",
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "insertNulls": false,
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "pointSize": 3,
            "scaleDistribution": {
              "type": "linear"
            },
            "showPoints": "never",
            "showValues": false,
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "unit": "cores",
          "min": 0,
          "max": 14
        }
      },
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "hideZeros": false,
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "topk(10, sum by (groupname) (rate(namedprocess_namegroup_cpu_seconds_total{job=\"host-process-exporter\",groupname=~\"${groupname_regex:raw}\"}[5m])))",
          "refId": "A",
          "legendFormat": "{{groupname}}",
          "format": "time_series",
          "range": true
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Matching groups: memory (PSS)",
      "description": "Memory y-axis fixed to total host memory, 33,054,044,160 bytes.",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "pluginVersion": "13.0.1",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "drawStyle": "line",
            "fillOpacity": 12,
            "gradientMode": "none",
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "insertNulls": false,
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "pointSize": 3,
            "scaleDistribution": {
              "type": "linear"
            },
            "showPoints": "never",
            "showValues": false,
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "unit": "bytes",
          "min": 0,
          "max": 33054044160
        }
      },
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "hideZeros": false,
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "topk(10, sum by (groupname) (namedprocess_namegroup_memory_bytes{job=\"host-process-exporter\",groupname=~\"${groupname_regex:raw}\",memtype=\"proportionalResident\"}))",
          "refId": "A",
          "legendFormat": "{{groupname}}",
          "format": "time_series",
          "range": true
        }
      ]
    },
    {
      "id": 3,
      "type": "table",
      "title": "Matching process groups",
      "description": "Enter a regex in Groupname regex. The default .* returns every active group.",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 16
      },
      "pluginVersion": "13.0.1",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "CPU (cores)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "cores"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "PSS"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "RSS"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Read (B/s)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "Bps"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Write (B/s)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "Bps"
              }
            ]
          }
        ]
      },
      "options": {
        "cellHeight": "sm",
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "CPU (cores)",
            "desc": true
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "sum by (groupname) (rate(namedprocess_namegroup_cpu_seconds_total{job=\"host-process-exporter\",groupname=~\"${groupname_regex:raw}\"}[5m])) or on (groupname) (0 * sum by (groupname) (namedprocess_namegroup_num_procs{job=\"host-process-exporter\",groupname=~\"${groupname_regex:raw}\"}))",
          "refId": "A",
          "legendFormat": "",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "sum by (groupname) (namedprocess_namegroup_memory_bytes{job=\"host-process-exporter\",groupname=~\"${groupname_regex:raw}\",memtype=\"proportionalResident\"})",
          "refId": "B",
          "legendFormat": "",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "sum by (groupname) (namedprocess_namegroup_memory_bytes{job=\"host-process-exporter\",groupname=~\"${groupname_regex:raw}\",memtype=\"resident\"})",
          "refId": "C",
          "legendFormat": "",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "sum by (groupname) (namedprocess_namegroup_num_procs{job=\"host-process-exporter\",groupname=~\"${groupname_regex:raw}\"})",
          "refId": "D",
          "legendFormat": "",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "sum by (groupname) (rate(namedprocess_namegroup_read_bytes_total{job=\"host-process-exporter\",groupname=~\"${groupname_regex:raw}\"}[5m])) or on (groupname) (0 * sum by (groupname) (namedprocess_namegroup_num_procs{job=\"host-process-exporter\",groupname=~\"${groupname_regex:raw}\"}))",
          "refId": "E",
          "legendFormat": "",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "sum by (groupname) (rate(namedprocess_namegroup_write_bytes_total{job=\"host-process-exporter\",groupname=~\"${groupname_regex:raw}\"}[5m])) or on (groupname) (0 * sum by (groupname) (namedprocess_namegroup_num_procs{job=\"host-process-exporter\",groupname=~\"${groupname_regex:raw}\"}))",
          "refId": "F",
          "legendFormat": "",
          "format": "table",
          "instant": true,
          "range": false
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "groupname",
            "mode": "inner"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time #A": true,
              "Time #B": true,
              "Time #C": true,
              "Time #D": true,
              "Time #E": true,
              "Time #F": true
            },
            "indexByName": {
              "groupname": 0,
              "CPU (cores)": 1,
              "PSS": 2,
              "RSS": 3,
              "Processes": 4,
              "Read (B/s)": 5,
              "Write (B/s)": 6
            },
            "renameByName": {
              "Value #A": "CPU (cores)",
              "Value #B": "PSS",
              "Value #C": "RSS",
              "Value #D": "Processes",
              "Value #E": "Read (B/s)",
              "Value #F": "Write (B/s)"
            }
          }
        }
      ]
    }
  ]
}
